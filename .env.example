# Copy to .env and replace every change-me value before starting Docker Compose.
POSTGRES_DB=expense_manager
POSTGRES_USER=expense_manager
POSTGRES_PASSWORD=change-me-local-db-password
JWT_SECRET=change-me-use-at-least-32-random-characters
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_FROM_ADDRESS=your-account@gmail.com
SMTP_FROM_NAME=Expense Manager
SMTP_USERNAME=your-account@gmail.com
SMTP_PASSWORD=change-me-gmail-app-password
