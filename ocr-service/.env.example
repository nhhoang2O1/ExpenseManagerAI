# Optional custom recognition model. Copy this file to .env and keep the model
# under ocr-service/models, which is mounted at /service/models in the container.
OCR_RECOGNITION_MODEL_DIR=/service/models/my_receipt_rec_model_v4_latin
OCR_RECOGNITION_MODEL_NAME=PP-OCRv4_mobile_rec
OCR_MODEL_VERSION=receipt-rec-v4-latin
