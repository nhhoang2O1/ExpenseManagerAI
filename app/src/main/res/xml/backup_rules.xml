<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- Android Keystore keys are device-bound and are not restored with
         EncryptedSharedPreferences. Never back up credentials or session state. -->
    <exclude domain="sharedpref" path="secure_backend_session.xml" />
    <exclude domain="sharedpref" path="expense_manager_session.xml" />
</full-backup-content>
