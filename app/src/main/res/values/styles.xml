<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Card Styles -->
    <style name="Widget.App.CardView" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="strokeColor">@color/outline</item>
        <item name="strokeWidth">@dimen/stroke_width</item>
    </style>

    <!-- Button Styles -->
    <style name="Widget.App.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">@dimen/control_corner_radius</item>
        <item name="android:minHeight">@dimen/touch_target</item>
    </style>

    <style name="Widget.App.Button.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/primary</item>
        <item name="android:textColor">@color/primary</item>
        <item name="cornerRadius">@dimen/control_corner_radius</item>
        <item name="android:minHeight">@dimen/touch_target</item>
    </style>

    <style name="Widget.App.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">@dimen/control_corner_radius</item>
        <item name="android:minHeight">@dimen/touch_target</item>
    </style>

    <!-- Text Input -->
    <style name="Widget.App.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/control_corner_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/control_corner_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/control_corner_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/control_corner_radius</item>
        <item name="boxStrokeColor">@color/outline</item>
    </style>

    <style name="Widget.App.Toolbar" parent="Widget.Material3.Toolbar.Surface">
        <item name="android:minHeight">@dimen/toolbar_height</item>
        <item name="titleTextColor">@color/text_primary</item>
        <item name="android:background">@color/background</item>
    </style>

    <style name="TextAppearance.App.PageTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.App.SectionTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

</resources>
